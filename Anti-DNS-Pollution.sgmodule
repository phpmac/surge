#!name=Anti-DNS-Pollution
#!desc=防DNS污染: 国内DNS + 加密DNS(IP直连) + 劫持硬编码DNS + always-real-ip. 需开启增强模式(Enhanced Mode)
#!author=phpmac

[General]
dns-server = %APPEND% 223.5.5.5, 223.6.6.6, 119.29.29.29
encrypted-dns-server = https://223.5.5.5/dns-query, https://doh.pub/dns-query
; 腾讯纯IP接入 https://120.53.53.53/dns-query 仍可用, 但官方2024-09-29起不再公开提供, 不推荐
encrypted-dns-follow-outbound-mode = false
hijack-dns = %APPEND% *:53
always-real-ip = %APPEND% dns.msftncsi.com, *.msftconnecttest.com, *.srv.nintendo.net, *.stun.playstation.net, xbox.*.microsoft.com, *.xboxlive.com, *.turn.twilio.com, *.stun.twilio.com, stun.syncthing.net, stun.*, lancache.steamcontent.com
